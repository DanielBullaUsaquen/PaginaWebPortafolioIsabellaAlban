---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nombre from '../components/Nombre.astro';
import retrato from '../assets/imagenes/imagen_isabella.jpg';
import logo from '../assets/imagenes/logo-ojo.png';
---

<Base
  title="Sobre mí"
  tema="vino"
  description="Isabella Andrea Albán Fernández diseña proyectos editoriales y de información sobre temas con poca visibilidad, combinando materiales tangibles y medios digitales."
>
  <article class="perfil">
    <div class="perfil__texto">
      <Nombre as="h1" lineas={['Isabella Andrea', 'Albán Fernández']} class="perfil__nombre" />

      <p class="perfil__presentacion">
        Diseño proyectos editoriales y de información sobre temas que usualmente tienen poca visibilidad, como los
        trastornos mentales, problemas personales y las emociones, utilizando materiales tangibles que me permiten hacer
        una exploración desde mi sensibilidad creadora, además de también utilizar medios digitales que me permiten hacer
        una composición con una alta calidad, logrando mostrar de forma efectiva aquellos temas que están ocultos, como lo
        es la pérdida de la independencia de las mujeres a través de las prendas de vestir, un tema que es difícil de
        mostrar, haciéndolo fácil de entender, de sentir y reflexionar.
      </p>

      <p class="perfil__rotulo" aria-hidden="true">Sobre<br />mí</p>
    </div>

    <figure class="perfil__retrato">
      <Picture
        src={retrato}
        formats={['avif', 'webp']}
        widths={[480, 760, 1086]}
        sizes="(min-width: 56rem) 45vw, 100vw"
        alt="Retrato de Isabella Andrea Albán Fernández sonriendo, con cabello largo oscuro y chaqueta negra, sobre fondo blanco."
        loading="eager"
      />
      <span class="perfil__sello" aria-hidden="true">
        <Image src={logo} alt="" width={120} densities={[1, 2]} />
      </span>
    </figure>
  </article>
</Base>

<style>
  .perfil {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    column-gap: var(--espacio-l);
    padding-left: var(--margen);
  }

  .perfil__texto {
    align-self: center;
    justify-self: center;
    display: grid;
    gap: var(--espacio-m);
    width: min(100%, 34rem);
    padding-block: var(--espacio-s) var(--espacio-l);
  }

  .perfil :global(.perfil__nombre) {
    font-size: clamp(2.1rem, 1rem + 2.2vw, 3.1rem);
  }

  .perfil__presentacion {
    font-size: clamp(1.05rem, 0.98rem + 0.25vw, 1.18rem);
    line-height: 1.55;
    color: var(--texto-suave);
    hyphens: auto;
  }

  .perfil__rotulo {
    justify-self: end;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.25rem);
    font-style: italic;
    font-weight: 400;
    line-height: 0.95;
    text-align: left;
  }

  /* Retrato en arco: la curva superior izquierda de la referencia,
     anclado al borde derecho e inferior de la página. */
  .perfil__retrato {
    position: relative;
    align-self: stretch;
    min-height: min(calc(100svh - 7rem), 52rem);
  }

  .perfil__retrato :global(picture) {
    position: absolute;
    inset: 0;
  }

  .perfil__retrato :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    border-top-left-radius: clamp(8rem, 22vw, 22rem);
    background: var(--blanco);
  }

  .perfil__sello {
    position: absolute;
    left: 0;
    bottom: clamp(2rem, 8%, 5rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: clamp(5rem, 9vw, 8.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--blanco);
  }

  .perfil__sello :global(img) {
    width: 72%;
    height: auto;
  }

  @media (max-width: 56rem) {
    .perfil {
      grid-template-columns: minmax(0, 1fr);
      padding-left: 0;
    }

    .perfil__texto {
      padding-inline: var(--margen);
      justify-self: start;
      width: min(100%, 36rem);
    }

    .perfil__retrato {
      order: -1;
      min-height: 0;
      aspect-ratio: 4 / 5;
      max-height: 78svh;
      margin-left: var(--margen);
    }

    .perfil__sello {
      left: auto;
      right: var(--margen);
      bottom: 0;
      translate: 0 50%;
    }

    .perfil__texto {
      padding-top: calc(var(--espacio-l) + 1rem);
    }
  }
</style>
